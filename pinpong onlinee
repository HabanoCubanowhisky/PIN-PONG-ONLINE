<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>NEON PONG ONLINE</title>

<script src="https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js"></script>

<style>
:root{
  --bg:#05070d;
  --panel:#0d1220;
  --text:#f3f7ff;
  --muted:#8ea0b8;
  --border:#34445f;
  --good:#6cffb0;
  --bad:#ff7b93;
}

*{box-sizing:border-box}

body{
  margin:0;
  min-height:100vh;
  display:grid;
  place-items:center;
  color:var(--text);
  font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
  background:
    radial-gradient(circle at 50% 10%, #1a2442 0%, #0a0e18 38%, #030509 78%);
}

.wrap{
  width:min(1040px,96vw);
  text-align:center;
  padding:18px 0;
}

h1{
  margin:0;
  letter-spacing:.18em;
  font-size:clamp(25px,4vw,48px);
  text-shadow:0 0 16px #fff6;
}

.subtitle{
  color:var(--muted);
  margin:6px 0 14px;
  font-size:13px;
  letter-spacing:.06em;
}

.shell{
  position:relative;
  padding:10px;
  border-radius:20px;
  border:2px solid var(--border);
  background:#0b0f1bbd;
  box-shadow:0 0 34px #91b7ff1f,inset 0 0 25px #fff1;
}

canvas{
  display:block;
  width:100%;
  height:auto;
  border-radius:13px;
  background:#05070c;
  touch-action:none;
}

.hud{
  position:absolute;
  left:0;
  right:0;
  top:24px;
  display:flex;
  justify-content:center;
  gap:80px;
  pointer-events:none;
  font-weight:900;
  font-size:clamp(26px,5vw,56px);
  text-shadow:0 0 12px #fff7;
}

.hud small{
  display:block;
  font-size:10px;
  color:#8295ad;
  letter-spacing:.22em;
}

.overlay{
  position:absolute;
  inset:10px;
  border-radius:13px;
  display:grid;
  place-items:center;
  background:#02050bc7;
  backdrop-filter:blur(5px);
}

.card{
  width:min(610px,90%);
  padding:24px;
  background:#080c15ef;
  border:1px solid #35445d;
  border-radius:18px;
  box-shadow:0 0 35px #fff1;
}

.card h2{
  font-size:clamp(25px,4vw,42px);
  margin:0 0 8px;
}

.card p{
  color:#a9b8ca;
  margin:8px 0;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:10px;
  margin-top:17px;
}

button,input{
  border-radius:999px;
  padding:12px 18px;
  font:inherit;
  font-weight:800;
}

button{
  border:0;
  cursor:pointer;
  background:#f3f7ff;
  color:#05070c;
  letter-spacing:.05em;
}

button.secondary{
  background:#172033;
  color:#e9f1ff;
  border:1px solid #3b4c69;
}

button:hover{
  transform:translateY(-1px);
}

button:disabled{
  opacity:.5;
  cursor:not-allowed;
}

input{
  min-width:210px;
  color:#fff;
  background:#090e18;
  border:1px solid #40506b;
  text-align:center;
  text-transform:uppercase;
  outline:none;
  letter-spacing:.12em;
}

.roomBox{
  display:none;
  margin:15px auto 4px;
  max-width:430px;
  padding:13px;
  border:1px dashed #50627e;
  border-radius:14px;
  background:#0b111d;
}

.code{
  font-size:26px;
  font-weight:1000;
  letter-spacing:.15em;
  margin:5px 0;
}

.status{
  margin-top:10px;
  font-size:13px;
  color:#8da1bb;
}

.status.good{color:var(--good)}
.status.bad{color:var(--bad)}

.tiny{
  font-size:12px!important;
  color:#73869e!important;
}

.controls{
  font-size:12px;
  color:#7f92aa;
  margin-top:10px;
}

.badge{
  position:absolute;
  right:24px;
  top:20px;
  font-size:11px;
  border:1px solid #41516c;
  border-radius:999px;
  padding:5px 9px;
  color:#9cafc6;
  background:#080c15cc;
}

@media(max-width:600px){
  .hud{gap:46px}
  .card{padding:18px}
  .actions{flex-direction:column;align-items:stretch}
  input{width:100%}
  .actions button{width:100%}
}
</style>
</head>

<body>

<div class="wrap">

  <h1>NEON PONG ONLINE</h1>
  <div class="subtitle">1 VS 1 · TIEMPO REAL · PRIMERO EN 7</div>

  <div class="shell">

    <canvas id="game" width="960" height="540"></canvas>

    <div class="hud">
      <div>
        <small>JUGADOR 1</small>
        <span id="score1">0</span>
      </div>

      <div>
        <small>JUGADOR 2</small>
        <span id="score2">0</span>
      </div>
    </div>

    <div class="badge" id="badge">DESCONECTADO</div>

    <div class="overlay" id="overlay">

      <div class="card">

        <h2 id="menuTitle">MULTIJUGADOR ONLINE</h2>

        <p id="menuText">
          Creá una sala y compartí el código, o ingresá al código de un amigo.
        </p>

        <div class="actions" id="mainActions">

          <button id="createBtn">
            CREAR SALA
          </button>

          <input
            id="roomInput"
            maxlength="8"
            placeholder="CÓDIGO"
          >

          <button
            class="secondary"
            id="joinBtn"
          >
            UNIRSE
          </button>

        </div>

        <div class="roomBox" id="roomBox">

          <div class="tiny">
            CÓDIGO DE SALA
          </div>

          <div class="code" id="roomCode">
            ------
          </div>

          <div class="actions">

            <button id="copyBtn">
              COPIAR INVITACIÓN
            </button>

          </div>

          <p class="tiny">
            Esperando al segundo jugador…
          </p>

        </div>

        <div class="status" id="status">
          Listo para conectar.
        </div>

      </div>

    </div>

  </div>

  <div class="controls">
    PC: W/S o flechas · Mouse · Celular: arrastrá el dedo · R: revancha
  </div>

</div>

<script>
(() => {

  const canvas = document.getElementById("game");
  const ctx = canvas.getContext("2d");

  const overlay = document.getElementById("overlay");

  const createBtn = document.getElementById("createBtn");
  const joinBtn = document.getElementById("joinBtn");
  const roomInput = document.getElementById("roomInput");

  const roomBox = document.getElementById("roomBox");
  const roomCodeEl = document.getElementById("roomCode");

  const copyBtn = document.getElementById("copyBtn");

  const statusEl = document.getElementById("status");
  const badge = document.getElementById("badge");

  const menuTitle = document.getElementById("menuTitle");
  const menuText = document.getElementById("menuText");

  const score1El = document.getElementById("score1");
  const score2El = document.getElementById("score2");

  const W = canvas.width;
  const H = canvas.height;

  const WIN = 7;

  const left = {
    x:28,
    y:H/2-58,
    w:14,
    h:116,
    speed:560,
    score:0
  };

  const right = {
    x:W-42,
    y:H/2-58,
    w:14,
    h:116,
    speed:560,
    score:0
  };

  const ball = {
    x:W/2,
    y:H/2,
    r:10,
    vx:0,
    vy:0,
    speed:410
  };

  const obstacles = [

    {
      x:W*.37,
      y:H*.18,
      w:18,
      h:112,
      vy:210,
      visible:true,
      timer:.65
    },

    {
      x:W*.62,
      y:H*.60,
      w:18,
      h:112,
      vy:-230,
      visible:true,
      timer:.82
    }

  ];

  let peer = null;
  let conn = null;

  let role = null;

  let connected = false;
  let playing = false;
  let paused = false;

  let keys = {};

  let particles = [];

  let last = performance.now();

  let lastSync = 0;

  let localGuestY = right.y;

  let currentRoom = "";

  let gameOver = false;

  const clamp = (v,a,b) =>
    Math.max(a,Math.min(b,v));

  function setStatus(text,type=""){

    statusEl.textContent = text;

    statusEl.className =
      "status " + type;

  }

  function setBadge(text,good=false){

    badge.textContent = text;

    badge.style.color =
      good
      ? "#6cffb0"
      : "#9cafc6";

  }

  function makeCode(){

    const chars =
      "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

    let s = "";

    for(let i=0;i<6;i++){

      s +=
        chars[
          Math.floor(
            Math.random()*chars.length
          )
        ];

    }

    return s;

  }

  function peerId(code){

    return "neonpong-" +
      code.toLowerCase();

  }

  function peerOptions(){

    return {

      debug:0,

      config:{
        iceServers:[

          {
            urls:
            "stun:stun.l.google.com:19302"
          },

          {
            urls:
            "stun:stun1.l.google.com:19302"
          },

          {
            urls:
            "stun:stun2.l.google.com:19302"
          }

        ]
      }

    };

  }

  function resetBall(
    dir=Math.random()>.5 ? 1 : -1
  ){

    ball.x = W/2;
    ball.y = H/2;

    ball.speed = 410;

    const a =
      Math.random()*.8-.4;

    ball.vx =
      Math.cos(a) *
      ball.speed *
      dir;

    ball.vy =
      Math.sin(a) *
      ball.speed;

  }

  function resetGame(){

    left.y =
      H/2-left.h/2;

    right.y =
      H/2-right.h/2;

    left.score = 0;
    right.score = 0;

    score1El.textContent = "0";
    score2El.textContent = "0";

    obstacles[0].x = W*.37;
    obstacles[0].y = H*.18;
    obstacles[0].visible = true;
    obstacles[0].timer = .65;

    obstacles[1].x = W*.62;
    obstacles[1].y = H*.60;
    obstacles[1].visible = true;
    obstacles[1].timer = .82;

    particles = [];

    gameOver = false;

    playing = true;

    paused = false;

    resetBall();

  }

  function spark(x,y,dir=1){

    for(let i=0;i<8;i++){

      particles.push({

        x,
        y,

        vx:
        (80+Math.random()*180)
        *dir,

        vy:
        (Math.random()-.5)
        *220,

        life:
        .25+
        Math.random()*.35

      });

    }

  }

  function send(data){

    if(
      conn &&
      conn.open
    ){

      try{

        conn.send(data);

      }catch(e){}

    }

  }

  function statePacket(){

    return {

      t:"state",

      leftY:left.y,
      rightY:right.y,

      ball:{
        x:ball.x,
        y:ball.y,
        vx:ball.vx,
        vy:ball.vy,
        speed:ball.speed
      },

      score1:left.score,
      score2:right.score,

      obstacles:
      obstacles.map(o=>({

        x:o.x,
        y:o.y,
        w:o.w,
        h:o.h,
        visible:o.visible

      })),

      playing,
      paused,
      gameOver

    };

  }

  function bindConnection(c){

    conn = c;

    conn.on(
      "open",
      ()=>{

        connected = true;

        setBadge(
          "ONLINE",
          true
        );

        setStatus(
          "¡Conectados! La partida comenzó.",
          "good"
        );

        overlay.style.display =
          "none";

        if(role==="host"){

          resetGame();

          send({
            t:"start"
          });

          send(
            statePacket()
          );

        }

      }
    );

    conn.on(
      "data",
      data=>{

        if(
          !data ||
          !data.t
        ) return;

        if(role==="host"){

          if(data.t==="input"){

            right.y =
              clamp(
                data.y,
                0,
                H-right.h
              );

          }

        }else{

          if(data.t==="start"){

            playing = true;

            gameOver = false;

            overlay.style.display =
              "none";

          }

          if(data.t==="state"){

            left.y =
              data.leftY;

            right.y =
              data.rightY;

            ball.x =
              data.ball.x;

            ball.y =
              data.ball.y;

            ball.vx =
              data.ball.vx;

            ball.vy =
              data.ball.vy;

            ball.speed =
              data.ball.speed;

            left.score =
              data.score1;

            right.score =
              data.score2;

            score1El.textContent =
              left.score;

            score2El.textContent =
              right.score;

            data.obstacles.forEach(
              (o,i)=>
                Object.assign(
                  obstacles[i],
                  o
                )
            );

            playing =
              data.playing;

            paused =
              data.paused;

            gameOver =
              data.gameOver;

            if(gameOver)
              showResult();

          }

        }

      }
    );

    conn.on(
      "close",
      disconnectUI
    );

    conn.on(
      "error",
      ()=>{
        disconnectUI(
          "Se perdió la conexión."
        );
      }
    );

  }

  function disconnectUI(
    msg=
    "El otro jugador se desconectó."
  ){

    connected = false;

    playing = false;

    setBadge(
      "DESCONECTADO"
    );

    overlay.style.display =
      "grid";

    menuTitle.textContent =
      "CONEXIÓN CERRADA";

    menuText.textContent =
      msg;

    roomBox.style.display =
      "none";

    setStatus(
      "Recargá la página para crear o entrar a otra sala.",
      "bad"
    );

  }

  createBtn.onclick = ()=>{

    currentRoom =
      makeCode();

    role = "host";

    roomCodeEl.textContent =
      currentRoom;

    roomBox.style.display =
      "block";

    setStatus(
      "Creando sala…"
    );

    createBtn.disabled =
      true;

    joinBtn.disabled =
      true;

    roomInput.disabled =
      true;

    peer =
      new Peer(
        peerId(currentRoom),
        peerOptions()
      );

    peer.on(
      "open",
      ()=>{

        setStatus(
          "Sala creada. Compartí el código o la invitación.",
          "good"
        );

        const u =
          new URL(
            location.href
          );

        u.searchParams.set(
          "room",
          currentRoom
        );

        history.replaceState(
          null,
          "",
          u
        );

      }
    );

    peer.on(
      "connection",
      c=>{

        if(
          conn &&
          conn.open
        ){

          c.close();

          return;

        }

        bindConnection(c);

      }
    );

    peer.on(
      "error",
      err=>{

        console.error(err);

        setStatus(
          "No se pudo crear la sala. Probá otra vez.",
          "bad"
        );

      }
    );

  };

  joinBtn.onclick = ()=>{

    const code =
      roomInput.value
      .trim()
      .toUpperCase();

    if(code.length<4){

      setStatus(
        "Ingresá un código válido.",
        "bad"
      );

      return;

    }

    currentRoom = code;

    role = "guest";

    setStatus(
      "Buscando sala…"
    );

    createBtn.disabled =
      true;

    joinBtn.disabled =
      true;

    roomInput.disabled =
      true;

    peer =
      new Peer(
        peerOptions()
      );

    peer.on(
      "open",
      ()=>{

        const c =
          peer.connect(
            peerId(code),
            {
              reliable:true
            }
          );

        bindConnection(c);

        setTimeout(
          ()=>{

            if(!connected){

              setStatus(
                "No se pudo conectar. Revisá el código o pedile al anfitrión que deje abierta la página.",
                "bad"
              );

              createBtn.disabled =
                false;

              joinBtn.disabled =
                false;

              roomInput.disabled =
                false;

            }

          },
          8000
        );

      }
    );

    peer.on(
      "error",
      err=>{

        console.error(err);

        if(
          err.type ===
          "peer-unavailable"
        ){

          setStatus(
            "No existe esa sala o el anfitrión salió.",
            "bad"
          );

        }else{

          setStatus(
            "Error de conexión. Intentá otra vez.",
            "bad"
          );

        }

        createBtn.disabled =
          false;

        joinBtn.disabled =
          false;

        roomInput.disabled =
          false;

      }
    );

  };

  copyBtn.onclick =
  async ()=>{

    const u =
      new URL(
        location.href
      );

    u.searchParams.set(
      "room",
      currentRoom
    );

    const text =
      `Entrá a jugar NEON PONG conmigo: ${u.toString()}`;

    try{

      await navigator.clipboard
        .writeText(text);

      copyBtn.textContent =
        "¡COPIADO!";

      setTimeout(
        ()=>{
          copyBtn.textContent =
            "COPIAR INVITACIÓN";
        },
        1200
      );

    }catch{

      prompt(
        "Copiá esta invitación:",
        text
      );

    }

  };

  function showResult(){

    if(!gameOver)
      return;

    overlay.style.display =
      "grid";

    const iWon =
      (
        role==="host" &&
        left.score >
        right.score
      )
      ||
      (
        role==="guest" &&
        right.score >
        left.score
      );

    menuTitle.textContent =
      iWon
      ? "¡GANASTE!"
      : "GAME OVER";

    menuText.textContent =
      role==="host"
      ? "Presioná R para iniciar una revancha."
      : "Esperando que el anfitrión inicie la revancha.";

    roomBox.style.display =
      "none";

    document
      .getElementById(
        "mainActions"
      )
      .style.display =
      "none";

    setStatus(
      iWon
      ? "Victoria online."
      : "Tu rival ganó esta partida.",
      iWon
      ? "good"
      : ""
    );

  }

  function obstacleUpdate(o,dt){

    o.timer -= dt;

    if(o.timer<=0){

      o.visible =
        !o.visible;

      if(o.visible){

        o.x =
          135+
          Math.random()*
          (W-270-o.w);

        o.y =
          16+
          Math.random()*
          (H-32-o.h);

        o.vy =
          (
            Math.random()>.5
            ? 1
            : -1
          )
          *
          (
            190+
            Math.random()*120
          );

        o.timer =
          .42+
          Math.random()*.36;

      }else{

        o.timer =
          .18+
          Math.random()*.23;

      }

    }

    o.y +=
      o.vy*dt;

    if(o.y<12){

      o.y=12;

      o.vy =
        Math.abs(o.vy);

    }

    if(
      o.y+o.h >
      H-12
    ){

      o.y =
        H-12-o.h;

      o.vy =
        -Math.abs(o.vy);

    }

  }

  function collideObstacle(o){

    if(!o.visible)
      return;

    const cx =
      clamp(
        ball.x,
        o.x,
        o.x+o.w
      );

    const cy =
      clamp(
        ball.y,
        o.y,
        o.y+o.h
      );

    const dx =
      ball.x-cx;

    const dy =
      ball.y-cy;

    if(
      dx*dx+
      dy*dy >
      ball.r*ball.r
    ) return;

    const sides = [

      {
        d:
        Math.abs(
          ball.x-o.x
        ),
        s:"L"
      },

      {
        d:
        Math.abs(
          ball.x-
          (o.x+o.w)
        ),
        s:"R"
      },

      {
        d:
        Math.abs(
          ball.y-o.y
        ),
        s:"T"
      },

      {
        d:
        Math.abs(
          ball.y-
          (o.y+o.h)
        ),
        s:"B"
      }

    ].sort(
      (a,b)=>a.d-b.d
    );

    if(
      sides[0].s==="L"
    ){

      ball.x =
        o.x-ball.r-1;

      ball.vx =
        -Math.abs(
          ball.vx
        );

    }

    if(
      sides[0].s==="R"
    ){

      ball.x =
        o.x+o.w+
        ball.r+1;

      ball.vx =
        Math.abs(
          ball.vx
        );

    }

    if(
      sides[0].s==="T"
    ){

      ball.y =
        o.y-ball.r-1;

      ball.vy =
        -Math.abs(
          ball.vy
        );

    }

    if(
      sides[0].s==="B"
    ){

      ball.y =
        o.y+o.h+
        ball.r+1;

      ball.vy =
        Math.abs(
          ball.vy
        );

    }

    spark(
      ball.x,
      ball.y,
      ball.vx>0
      ? 1
      : -1
    );

  }

  function paddleHit(
    p,
    isLeft
  ){

    const inY =
      ball.y+
      ball.r >=
      p.y
      &&
      ball.y-
      ball.r <=
      p.y+p.h;

    const inX =
      isLeft
      ?
      ball.x-
      ball.r <=
      p.x+p.w
      &&
      ball.x >=
      p.x
      :
      ball.x+
      ball.r >=
      p.x
      &&
      ball.x <=
      p.x+p.w;

    if(
      !inX ||
      !inY
    ) return;

    const rel =
      (
        ball.y-
        (
          p.y+
          p.h/2
        )
      )
      /
      (
        p.h/2
      );

    ball.speed =
      Math.min(
        ball.speed*
        1.055,
        860
      );

    const angle =
      rel*.98;

    const dir =
      isLeft
      ? 1
      : -1;

    ball.vx =
      Math.cos(angle)*
      ball.speed*
      dir;

    ball.vy =
      Math.sin(angle)*
      ball.speed;

    ball.x =
      isLeft
      ?
      p.x+
      p.w+
      ball.r
      :
      p.x-
      ball.r;

    spark(
      ball.x,
      ball.y,
      dir
    );

  }

  function updateHost(
    dt,
    now
  ){

    if(
      !playing ||
      paused ||
      gameOver
    ) return;

    let d=0;

    if(
      keys.w ||
      keys.arrowup
    )
      d -=
        left.speed*
        dt;

    if(
      keys.s ||
      keys.arrowdown
    )
      d +=
        left.speed*
        dt;

    left.y =
      clamp(
        left.y+d,
        0,
        H-left.h
      );

    obstacles.forEach(
      o=>{

        obstacleUpdate(
          o,
          dt
        );

        collideObstacle(
          o
        );

      }
    );

    ball.x +=
      ball.vx*dt;

    ball.y +=
      ball.vy*dt;

    if(
      ball.y-
      ball.r <=0
      &&
      ball.vy<0
    ){

      ball.y =
        ball.r;

      ball.vy *= -1;

      spark(
        ball.x,
        ball.y,
        1
      );

    }

    if(
      ball.y+
      ball.r >=H
      &&
      ball.vy>0
    ){

      ball.y =
        H-ball.r;

      ball.vy *= -1;

      spark(
        ball.x,
        ball.y,
        -1
      );

    }

    if(ball.vx<0)
      paddleHit(
        left,
        true
      );
    else
      paddleHit(
        right,
        false
      );

    if(
      ball.x < -30
    ){

      right.score++;

      score2El.textContent =
        right.score;

      if(
        right.score >=
        WIN
      ){

        gameOver = true;

        playing = false;

        showResult();

      }else{

        resetBall(-1);

      }

    }

    if(
      ball.x >
      W+30
    ){

      left.score++;

      score1El.textContent =
        left.score;

      if(
        left.score >=
        WIN
      ){

        gameOver = true;

        playing = false;

        showResult();

      }else{

        resetBall(1);

      }

    }

    particles.forEach(
      p=>{

        p.x +=
          p.vx*dt;

        p.y +=
          p.vy*dt;

        p.life -=
          dt;

      }
    );

    particles =
      particles.filter(
        p=>p.life>0
      );

    if(
      now-lastSync >
      32
    ){

      send(
        statePacket()
      );

      lastSync =
        now;

    }

  }

  function updateGuest(dt){

    if(
      !connected ||
      gameOver
    ) return;

    let d=0;

    if(
      keys.w ||
      keys.arrowup
    )
      d -=
        right.speed*
        dt;

    if(
      keys.s ||
      keys.arrowdown
    )
      d +=
        right.speed*
        dt;

    if(d){

      localGuestY =
        clamp(
          localGuestY+d,
          0,
          H-right.h
        );

      right.y =
        localGuestY;

      send({
        t:"input",
        y:localGuestY
      });

    }

  }

  function draw(){

    ctx.clearRect(
      0,
      0,
      W,
      H
    );

    ctx.fillStyle =
      "#05070c";

    ctx.fillRect(
      0,
      0,
      W,
      H
    );

    ctx.strokeStyle =
      "rgba(130,170,220,.075)";

    ctx.lineWidth = 1;

    for(
      let x=0;
      x<W;
      x+=48
    ){

      ctx.beginPath();

      ctx.moveTo(
        x,
        0
      );

      ctx.lineTo(
        x,
        H
      );

      ctx.stroke();

    }

    for(
      let y=0;
      y<H;
      y+=48
    ){

      ctx.beginPath();

      ctx.moveTo(
        0,
        y
      );

      ctx.lineTo(
        W,
        y
      );

      ctx.stroke();

    }

    ctx.setLineDash([
      12,
      14
    ]);

    ctx.strokeStyle =
      "rgba(220,235,255,.3)";

    ctx.lineWidth =
      3;

    ctx.beginPath();

    ctx.moveTo(
      W/2,
      0
    );

    ctx.lineTo(
      W/2,
      H
    );

    ctx.stroke();

    ctx.setLineDash([]);

    const rect =
      (
        x,
        y,
        w,
        h
      )=>{

        ctx.save();

        ctx.shadowBlur =
          22;

        ctx.shadowColor =
          "#fff";

        ctx.fillStyle =
          "#f3f7ff";

        ctx.fillRect(
          x,
          y,
          w,
          h
        );

        ctx.restore();

      };

    obstacles.forEach(
      o=>{

        if(!o.visible)
          return;

        ctx.save();

        ctx.shadowBlur =
          26;

        ctx.shadowColor =
          "#fff";

        ctx.fillStyle =
          "rgba(220,235,255,.92)";

        ctx.fillRect(
          o.x,
          o.y,
          o.w,
          o.h
        );

        ctx.shadowBlur =
          0;

        ctx.strokeStyle =
          "rgba(110,155,220,.65)";

        ctx.lineWidth =
          2;

        ctx.strokeRect(
          o.x-3,
          o.y-3,
          o.w+6,
          o.h+6
        );

        ctx.restore();

      }
    );

    rect(
      left.x,
      left.y,
      left.w,
      left.h
    );

    rect(
      right.x,
      right.y,
      right.w,
      right.h
    );

    ctx.save();

    ctx.shadowBlur =
      27;

    ctx.shadowColor =
      "#fff";

    ctx.fillStyle =
      "#fff";

    ctx.beginPath();

    ctx.arc(
      ball.x,
      ball.y,
      ball.r,
      0,
      Math.PI*2
    );

    ctx.fill();

    ctx.restore();

    ctx.save();

    ctx.fillStyle =
      "#fff";

    particles.forEach(
      p=>{

        ctx.globalAlpha =
          clamp(
            p.life*2,
            0,
            1
          );

        ctx.fillRect(
          p.x,
          p.y,
          3,
          3
        );

      }
    );

    ctx.restore();

  }

  function loop(now){

    const dt =
      Math.min(
        (
          now-last
        )/1000,
        .025
      );

    last = now;

    if(
      role==="host"
    )
      updateHost(
        dt,
        now
      );

    if(
      role==="guest"
    )
      updateGuest(dt);

    draw();

    requestAnimationFrame(
      loop
    );

  }

  function setPaddleFromClientY(
    clientY
  ){

    const r =
      canvas
      .getBoundingClientRect();

    const y =
      (
        clientY-
        r.top
      )
      *
      (
        H/
        r.height
      );

    if(
      role==="host"
    ){

      left.y =
        clamp(
          y-left.h/2,
          0,
          H-left.h
        );

    }else if(
      role==="guest"
    ){

      localGuestY =
        clamp(
          y-right.h/2,
          0,
          H-right.h
        );

      right.y =
        localGuestY;

      send({
        t:"input",
        y:localGuestY
      });

    }

  }

  canvas.addEventListener(
    "mousemove",
    e=>{

      if(connected)
        setPaddleFromClientY(
          e.clientY
        );

    }
  );

  canvas.addEventListener(
    "touchmove",
    e=>{

      e.preventDefault();

      if(
        connected &&
        e.touches[0]
      ){

        setPaddleFromClientY(
          e.touches[0]
          .clientY
        );

      }

    },
    {
      passive:false
    }
  );

  addEventListener(
    "keydown",
    e=>{

      keys[
        e.key.toLowerCase()
      ] = true;

      if(
        [
          "ArrowUp",
          "ArrowDown",
          " "
        ]
        .includes(e.key)
      ){

        e.preventDefault();

      }

      if(
        e.key.toLowerCase()
        ===
        "r"
        &&
        role==="host"
        &&
        gameOver
      ){

        overlay.style.display =
          "none";

        resetGame();

        send({
          t:"start"
        });

      }

    }
  );

  addEventListener(
    "keyup",
    e=>{

      keys[
        e.key.toLowerCase()
      ] = false;

    }
  );

  const preset =
    new URLSearchParams(
      location.search
    )
    .get("room");

  if(preset){

    roomInput.value =
      preset.toUpperCase();

    setStatus(
      "Invitación detectada. Entrando a la sala…",
      "good"
    );

    setTimeout(
      ()=>{
        joinBtn.click();
      },
      600
    );

  }

  resetBall();

  requestAnimationFrame(
    loop
  );

})();
</script>

